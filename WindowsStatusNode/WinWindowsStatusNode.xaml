<Window x:Class="Samsun.SGamma.WindowsMonitorNode.Views.WinWindowsStatusNode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Samsun.SGamma.WindowsMonitorNode.ViewModels"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:models="clr-namespace:Samsun.SGamma.WindowsMonitorNode.Models"
        mc:Ignorable="d" Title="{x:Static models:NodeNames.WindowsStatus}"
        WindowStartupLocation="CenterScreen"
            Width="700"
            Height="780"
            MinWidth="640"
            MinHeight="580"
            MaxWidth="940"
            MaxHeight="960"
            ResizeMode="CanResize"
        Style="{StaticResource WindowSmallStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Samsun.SGamma.Common.UI;component/Styles/SamStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Samsun.SGamma.FlowTools.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 卡片容器：圆角 + 阴影 + 弱边框 -->
            <Style x:Key="ParamCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushLight}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 分组小标题（警告/异常） -->
            <Style x:Key="SubTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,10,0,4" />
            </Style>

            <!-- 字段标签 -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- 数值输入（hc:NumericUpDown）：统一可见圆角边框 -->
            <Style x:Key="NumInput" TargetType="hc:NumericUpDown">
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#C8C8C8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="6" />
            </Style>

            <!-- 文本输入：统一可见圆角边框 -->
            <Style x:Key="TextInput" TargetType="hc:TextBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#C8C8C8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.DataContext>
        <local:WinWindowsStatusNodeVM />
    </Window.DataContext>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition Height="1" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="36" Background="{DynamicResource BrushBlack}" MouseDown="OnDragWindow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WindowTitleText" Grid.Column="0" VerticalAlignment="Center"
                           Text="{x:Static models:NodeNames.WindowsStatus}"
                           Foreground="White" FontSize="14" FontWeight="Bold" Margin="12,0,0,0" />
                <Button Grid.Column="2"
                        Style="{DynamicResource ButtonIcon}"
                        Foreground="White" Width="46" Height="36"
                        hc:IconElement.Geometry="{DynamicResource CloseGeometry}" hc:IconElement.Height="14"
                        IsCancel="True" />
            </Grid>

            <!-- 参数配置区 -->
            <ScrollViewer Grid.Row="1" Margin="14,10,14,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical" Margin="2,0,2,6">

                    <!-- 基本信息 -->
                    <Border Style="{StaticResource ParamCard}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="名称" />
                            <hc:TextBox Text="{Binding ToolName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <!-- CPU -->
                    <Border Style="{StaticResource ParamCard}">
                        <StackPanel Orientation="Vertical">
                            <hc:Divider Content="CPU" FontSize="14" />
                            <CheckBox Content="CPU监控启用" IsChecked="{Binding Param.CpuWarnEnabled}" Margin="0,4,0,0" FontSize="12" />
                            <TextBlock Style="{StaticResource SubTitle}" Text="警告" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告上限(%)" />
                                    <hc:NumericUpDown Value="{Binding Param.CpuWarnUpperPercent}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告周期(秒)" />
                                    <hc:NumericUpDown  Value="{Binding Param.CpuWarnPeriodSec}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource SubTitle}" Text="异常" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常上限(%)" />
                                    <hc:NumericUpDown Value="{Binding Param.CpuExUpperPercent}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常周期(秒)" />
                                    <hc:NumericUpDown Value="{Binding Param.CpuExPeriodSec}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 内存 -->
                    <Border Style="{StaticResource ParamCard}">
                        <StackPanel Orientation="Vertical">
                            <hc:Divider Content="内存" FontSize="14" />
                            <CheckBox Content="内存监控启用" IsChecked="{Binding Param.MemoryWarnEnabled}" Margin="0,4,0,0" FontSize="12" />
                            <TextBlock Style="{StaticResource SubTitle}" Text="警告" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告上限(%)" />
                                    <hc:NumericUpDown Value="{Binding Param.MemoryWarnUpperPercent}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告周期(秒)" />
                                    <hc:NumericUpDown Value="{Binding Param.MemoryWarnPeriodSec}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource SubTitle}" Text="异常" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常上限(%)" />
                                    <hc:NumericUpDown Value="{Binding Param.MemoryExUpperPercent}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常周期(秒)" />
                                    <hc:NumericUpDown Value="{Binding Param.MemoryExPeriodSec}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 磁盘容量 -->
                    <Border Style="{StaticResource ParamCard}">
                        <StackPanel Orientation="Vertical">
                            <hc:Divider Content="磁盘容量" FontSize="14" />
                            <CheckBox Content="磁盘容量监控启用" IsChecked="{Binding Param.DiskSpaceWarnEnabled}" Margin="0,4,0,0" FontSize="12" />
                            <TextBlock Style="{StaticResource SubTitle}" Text="警告" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告下限(GB)" />
                                    <hc:NumericUpDown Value="{Binding Param.DiskSpaceWarnLowerGB}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告周期(秒)" />
                                    <hc:NumericUpDown Value="{Binding Param.DiskSpaceWarnPeriodSec}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource SubTitle}" Text="异常" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常下限(GB)" />
                                    <hc:NumericUpDown Value="{Binding Param.DiskSpaceExLowerGB}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常周期(秒)" />
                                    <hc:NumericUpDown Value="{Binding Param.DiskSpaceExPeriodSec}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 目录权限 -->
                    <Border Style="{StaticResource ParamCard}">
                        <StackPanel Orientation="Vertical">
                            <hc:Divider Content="目录权限" FontSize="14" />
                            <CheckBox Content="目录权限监控启用" IsChecked="{Binding Param.DirPermWarnEnabled}" Margin="0,4,0,0" FontSize="12" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="警告路径" />
                            <hc:TextBox Text="{Binding Param.DirPermWarnPaths, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="警告周期(秒)" />
                            <hc:NumericUpDown Value="{Binding Param.DirPermWarnPeriodSec}" />
                            <CheckBox Content="目录权限异常监控启用" IsChecked="{Binding Param.DirPermExEnabled}" Margin="0,14,0,0" FontSize="12" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="异常路径" />
                            <hc:TextBox Style="{StaticResource TextInput}"
                                        Text="{Binding Param.DirPermExPaths, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="异常周期(秒)" />
                            <hc:NumericUpDown Value="{Binding Param.DirPermExPeriodSec}" />
                        </StackPanel>
                    </Border>

                    <!-- Ping -->
                    <Border Style="{StaticResource ParamCard}">
                        <StackPanel Orientation="Vertical">
                            <hc:Divider Content="Ping" FontSize="14" />
                            <CheckBox Content="Ping监控启用" IsChecked="{Binding Param.PingWarnEnabled}" Margin="0,4,0,0" FontSize="12" />
                            <TextBlock Style="{StaticResource SubTitle}" Text="警告" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="警告IP" />
                            <hc:TextBox Text="{Binding Param.PingWarnIps, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告RTT(ms)" />
                                    <hc:NumericUpDown Value="{Binding Param.PingWarnRttMs}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告丢包(%)" />
                                    <hc:NumericUpDown Value="{Binding Param.PingWarnLossPercent}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="警告周期(秒)" />
                            <hc:NumericUpDown Value="{Binding Param.PingWarnPeriodSec}" />
                            <TextBlock Style="{StaticResource SubTitle}" Text="异常" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="异常IP" />
                            <hc:TextBox Text="{Binding Param.PingExIps, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常RTT(ms)" />
                                    <hc:NumericUpDown Value="{Binding Param.PingExRttMs}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常丢包(%)" />
                                    <hc:NumericUpDown Value="{Binding Param.PingExLossPercent}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="异常周期(秒)" />
                            <hc:NumericUpDown Value="{Binding Param.PingExPeriodSec}" />
                        </StackPanel>
                    </Border>

                    <!-- 磁盘IO -->
                    <Border Style="{StaticResource ParamCard}">
                        <StackPanel Orientation="Vertical">
                            <hc:Divider Content="磁盘IO" FontSize="14" />
                            <CheckBox Content="磁盘IO记录启用" IsChecked="{Binding Param.DiskIoEnabled}" Margin="0,4,0,0" FontSize="12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="采样间隔(秒)" />
                                    <hc:NumericUpDown Value="{Binding Param.DiskIoSampleIntervalSec}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="记录周期(秒)" />
                                    <hc:NumericUpDown Value="{Binding Param.DiskIoPeriodSec}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SGamma 本进程 -->
                    <Border Style="{StaticResource ParamCard}">
                        <StackPanel Orientation="Vertical">
                            <hc:Divider Content="SGamma 本进程" FontSize="14" />
                            <CheckBox Content="SGamma监控启用" IsChecked="{Binding Param.SgammaWarnEnabled}" Margin="0,4,0,0" FontSize="12" />
                            <TextBlock Style="{StaticResource SubTitle}" Text="警告" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告内存(GB)" />
                                    <hc:NumericUpDown Value="{Binding Param.SgammaWarnMemoryGB}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告句柄" />
                                    <hc:NumericUpDown Value="{Binding Param.SgammaWarnHandleMax}" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告线程" />
                                    <hc:NumericUpDown Value="{Binding Param.SgammaWarnThreadMax}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="警告GDI" />
                                    <hc:NumericUpDown Value="{Binding Param.SgammaWarnGdiMax}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="警告周期(秒)" />
                            <hc:NumericUpDown Value="{Binding Param.SgammaWarnPeriodSec}" />
                            <TextBlock Style="{StaticResource SubTitle}" Text="异常" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常内存(GB)" />
                                    <hc:NumericUpDown Value="{Binding Param.SgammaExMemoryGB}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常句柄" />
                                    <hc:NumericUpDown Value="{Binding Param.SgammaExHandleMax}" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常线程" />
                                    <hc:NumericUpDown Value="{Binding Param.SgammaExThreadMax}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常GDI" />
                                    <hc:NumericUpDown Value="{Binding Param.SgammaExGdiMax}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="异常周期(秒)" />
                            <hc:NumericUpDown Value="{Binding Param.SgammaExPeriodSec}" />
                        </StackPanel>
                    </Border>

                    <!-- 参数操作按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,2,0">
                        <Button Content="更新" Width="85" Height="32" Margin="0,0,8,0"
                                FontSize="13" hc:BorderElement.CornerRadius="4"
                                Style="{StaticResource ButtonPrimary}"
                                Command="{Binding UpdateCommand}" />
                        <Button Content="保存" Width="85" Height="32"
                                FontSize="13" hc:BorderElement.CornerRadius="4"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Rectangle Grid.Row="2" Height="1" Fill="{DynamicResource BorderBrush}" Margin="10,0" />
            <Border Grid.Row="3" Background="{DynamicResource BrushLight}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="取消" Width="85" Height="32" Margin="0,0,8,0"
                            FontSize="13" hc:BorderElement.CornerRadius="4"
                            Command="{Binding CloseCommand}" IsCancel="True" />
                    <Button Grid.Column="2" Content="确认" Width="85" Height="32"
                            FontSize="13" hc:BorderElement.CornerRadius="4"
                            Style="{StaticResource ButtonPrimary}" IsDefault="True"
                            Command="{Binding ConfirmCommand}"
                            FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>